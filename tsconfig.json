{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"playwright.config.ts"
	],
	"exclude": ["node_modules"]
}
