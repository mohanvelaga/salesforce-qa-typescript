# Salesforce UI URL, if available
SF_UI_URL=

# Salesforce instance URL, e.g. https://your-domain.my.salesforce.com
SF_INSTANCE_URL=

# Salesforce API version
SF_API_VERSION=vXX.X

# Use a pre-generated access token only in a local, uncommitted .env file
SF_ACCESS_TOKEN=

# Set to true only when Salesforce credentials and URLs are configured
RUN_SALESFORCE_TESTS=false
